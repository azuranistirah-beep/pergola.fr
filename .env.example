# -----------------------------------------------------------------------------
# MySQL database (Hostinger Business or any MySQL 8+ server)
# -----------------------------------------------------------------------------
# One of two forms works:
#   1) A single URL — mysql://user:pass@host:3306/dbname
#   2) Discrete host/user/password/database env vars (below)
# When both are set, MYSQL_URL wins.
MYSQL_URL="mysql://user:password@127.0.0.1:3306/pergolafr"

# Discrete form — leave blank if MYSQL_URL is set.
MYSQL_HOST=""
MYSQL_PORT="3306"
MYSQL_USER=""
MYSQL_PASSWORD=""
MYSQL_DATABASE=""
# Optional connection pool sizing; defaults to 10.
MYSQL_POOL_SIZE="10"

# -----------------------------------------------------------------------------
# Admin panel (/admin routes)
# -----------------------------------------------------------------------------
# HMAC secret used to sign the admin session cookie. Rotate to invalidate
# every session at once. Generate: `openssl rand -hex 32`.
ADMIN_SESSION_SECRET=""

# Legacy single-password fallback (currently unused — admin_users table is the
# source of truth). Kept only so the env-check in src/lib/admin-auth doesn't
# throw during migration.
ADMIN_PASSWORD=""

# -----------------------------------------------------------------------------
# Public site
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://pergolafr.com"
