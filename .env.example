# -----------------------------------------------------------------------------
# InsForge backend (Postgres + Auth + Storage + Functions)
# -----------------------------------------------------------------------------
# Public (safe to expose): anon key for the browser SDK.
NEXT_PUBLIC_INSFORGE_URL="https://<projectkey>.<region>.insforge.app"
NEXT_PUBLIC_INSFORGE_ANON_KEY=""

# Server-only: full API key. NEVER expose in client bundles.
INSFORGE_URL="https://<projectkey>.<region>.insforge.app"
INSFORGE_API_KEY=""

# -----------------------------------------------------------------------------
# Admin panel (/admin routes)
# -----------------------------------------------------------------------------
# HMAC secret used to sign the admin session cookie. Rotate to invalidate
# every session at once. Generate: `openssl rand -hex 32`.
ADMIN_SESSION_SECRET=""

# Legacy single-password fallback (currently unused — admin_users table is the
# source of truth). Kept only so the env-check in src/lib/admin-auth doesn't
# throw during migration.
ADMIN_PASSWORD=""

# -----------------------------------------------------------------------------
# Public site
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://pergolafr.com"
