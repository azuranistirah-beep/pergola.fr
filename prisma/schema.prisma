// Pergola FR — Prisma schema (MySQL / Hostinger)
// Money stored as integer cents (Int). Currency defaults to EUR.
// Multilingual content: base row + *Translation join on (id, locale).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  STAFF
  ADMIN
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentProvider {
  STRIPE
  PAYPAL
  BANK_TRANSFER
}

enum ConfigOptionType {
  DIMENSION_WIDTH
  DIMENSION_LENGTH
  DIMENSION_HEIGHT
  ROOF_TYPE
  FRAME_COLOR
  ROOF_COLOR
  MATERIAL
  FEATURE_TOGGLE
  ACCESSORY
  INSTALLATION
  FOUNDATION
}

enum PriceModifierType {
  FLAT
  PERCENT
  PER_SQUARE_METER
  PER_LINEAR_METER
}

enum RuleAction {
  REQUIRE
  INCOMPATIBLE
  DEFAULT
}

enum CouponType {
  FIXED
  PERCENT
}

enum ProjectType {
  RESIDENTIAL
  COMMERCIAL
  HOTEL
  RESTAURANT
  POOLSIDE
  OTHER
}

enum QuoteStatus {
  NEW
  CONTACTED
  QUOTED
  WON
  LOST
}

enum ContactStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

// ─────────────────────────────────────────────────────────────
// Auth (Auth.js)
// ─────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  passwordHash  String?
  role          UserRole  @default(CUSTOMER)
  locale        String    @default("fr") @db.VarChar(8)
  phone         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  addresses Address[]
  orders    Order[]
  cart      Cart?
  wishlist  WishlistItem[]
  reviews   Review[]
  auditLogs AuditLog[]
  media     Media[]

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Address {
  id                String   @id @default(cuid())
  userId            String
  firstName         String
  lastName          String
  company           String?
  street            String
  street2           String?
  city              String
  postalCode        String   @db.VarChar(16)
  region            String?
  country           String   @db.VarChar(2)
  phone             String?
  isDefaultShipping Boolean  @default(false)
  isDefaultBilling  Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────
// Catalog
// ─────────────────────────────────────────────────────────────

model Category {
  id         String   @id @default(cuid())
  slug       String   @unique @db.VarChar(160)
  parentId   String?
  order      Int      @default(0)
  imageUrl   String?  @db.Text
  isFeatured Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  parent       Category?             @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[]            @relation("CategoryTree")
  translations CategoryTranslation[]
  products     Product[]

  @@index([parentId])
  @@index([isFeatured])
}

model CategoryTranslation {
  id          String  @id @default(cuid())
  categoryId  String
  locale      String  @db.VarChar(8)
  name        String
  description String? @db.Text

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
}

model Product {
  id             String        @id @default(cuid())
  sku            String        @unique @db.VarChar(64)
  slug           String        @unique @db.VarChar(200)
  categoryId     String
  status         ProductStatus @default(DRAFT)
  basePriceCents Int
  currency       String        @default("EUR") @db.VarChar(3)
  stock          Int           @default(0)
  weightGrams    Int?
  isConfigurable Boolean       @default(false)
  isFeatured     Boolean       @default(false)
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  category            Category             @relation(fields: [categoryId], references: [id])
  translations        ProductTranslation[]
  media               ProductMedia[]
  specifications      Specification[]
  downloads           Download[]
  reviews             Review[]
  variants            ProductVariant[]
  configuratorOptions ConfiguratorOption[]
  optionRules         OptionRule[]
  wishlistItems       WishlistItem[]
  quoteRequests       QuoteRequest[]

  @@index([categoryId, status])
  @@index([isFeatured, status])
  @@index([publishedAt])
}

model ProductTranslation {
  id           String  @id @default(cuid())
  productId    String
  locale       String  @db.VarChar(8)
  name         String
  shortDesc    String? @db.Text
  description  String? @db.LongText
  featuresJson Json?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
}

model ProductMedia {
  id          String    @id @default(cuid())
  productId   String
  url         String    @db.Text
  altText     String?
  type        MediaType @default(IMAGE)
  order       Int       @default(0)
  isLifestyle Boolean   @default(false)
  isCover     Boolean   @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Specification {
  id        String @id @default(cuid())
  productId String
  locale    String @db.VarChar(8)
  group     String
  label     String
  value     String @db.Text
  order     Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, locale])
}

model Download {
  id        String  @id @default(cuid())
  productId String
  label     String
  url       String  @db.Text
  fileSize  Int?
  mimeType  String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVariant {
  id                 String @id @default(cuid())
  productId          String
  sku                String @unique @db.VarChar(64)
  priceModifierCents Int    @default(0)
  stock              Int    @default(0)
  attributesJson     Json?

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  cartItems  CartItem[]

  @@index([productId])
}

// ─────────────────────────────────────────────────────────────
// Configurator (rule-based, admin-editable)
// ─────────────────────────────────────────────────────────────

model ConfiguratorOption {
  id         String           @id @default(cuid())
  productId  String
  code       String           @db.VarChar(64)
  type       ConfigOptionType
  label      String
  order      Int              @default(0)
  isRequired Boolean          @default(false)

  product     Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  values      ConfiguratorOptionValue[]
  sourceRules OptionRule[]              @relation("RuleSourceOption")
  targetRules OptionRule[]              @relation("RuleTargetOption")

  @@unique([productId, code])
  @@index([productId])
}

model ConfiguratorOptionValue {
  id               String            @id @default(cuid())
  optionId         String
  code             String            @db.VarChar(64)
  label            String
  priceType        PriceModifierType @default(FLAT)
  priceAmountCents Int               @default(0)
  imageUrl         String?           @db.Text
  swatchColor      String?           @db.VarChar(16)
  order            Int               @default(0)
  isDefault        Boolean           @default(false)
  // Dimension-typed options use these instead of discrete values:
  minMm            Int?
  maxMm            Int?
  stepMm           Int?

  option      ConfiguratorOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  sourceRules OptionRule[]       @relation("RuleSourceValue")
  targetRules OptionRule[]       @relation("RuleTargetValue")

  @@unique([optionId, code])
  @@index([optionId])
}

model OptionRule {
  id             String     @id @default(cuid())
  productId      String
  sourceOptionId String
  sourceValueId  String?
  targetOptionId String
  targetValueId  String?
  action         RuleAction

  product      Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sourceOption ConfiguratorOption       @relation("RuleSourceOption", fields: [sourceOptionId], references: [id], onDelete: Cascade)
  sourceValue  ConfiguratorOptionValue? @relation("RuleSourceValue", fields: [sourceValueId], references: [id], onDelete: SetNull)
  targetOption ConfiguratorOption       @relation("RuleTargetOption", fields: [targetOptionId], references: [id], onDelete: Cascade)
  targetValue  ConfiguratorOptionValue? @relation("RuleTargetValue", fields: [targetValueId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([sourceOptionId])
  @@index([targetOptionId])
}

// ─────────────────────────────────────────────────────────────
// Cart / Wishlist / Compare
// ─────────────────────────────────────────────────────────────

model Cart {
  id            String   @id @default(cuid())
  userId        String?  @unique
  sessionToken  String?  @unique
  currency      String   @default("EUR") @db.VarChar(3)
  couponCode    String?
  subtotalCents Int      @default(0)
  totalCents    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  items CartItem[]
}

model CartItem {
  id                String   @id @default(cuid())
  cartId            String
  productId         String
  variantId         String?
  configurationJson Json?
  computedSku       String?  @db.VarChar(128)
  quantity          Int      @default(1)
  unitPriceCents    Int
  createdAt         DateTime @default(now())

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([cartId])
  @@index([productId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

// ─────────────────────────────────────────────────────────────
// Orders
// ─────────────────────────────────────────────────────────────

model Order {
  id                String          @id @default(cuid())
  orderNumber       String          @unique @db.VarChar(24)
  userId            String?
  email             String
  phone             String?
  status            OrderStatus     @default(PENDING)
  paymentStatus     PaymentStatus   @default(PENDING)
  paymentProvider   PaymentProvider @default(STRIPE)
  paymentIntentId   String?         @db.VarChar(128)
  subtotalCents     Int
  shippingCents     Int             @default(0)
  taxCents          Int             @default(0)
  discountCents     Int             @default(0)
  totalCents        Int
  currency          String          @default("EUR") @db.VarChar(3)
  couponCode        String?
  shippingAddressId String?
  billingAddressId  String?
  notes             String?         @db.Text
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  user     User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  items    OrderItem[]
  timeline OrderTimelineEvent[]

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderItem {
  id                String  @id @default(cuid())
  orderId           String
  productId         String
  variantId         String?
  name              String
  sku               String  @db.VarChar(128)
  quantity          Int
  unitPriceCents    Int
  totalCents        Int
  configurationJson Json?

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model OrderTimelineEvent {
  id          String      @id @default(cuid())
  orderId     String
  status      OrderStatus
  note        String?     @db.Text
  createdAt   DateTime    @default(now())
  createdById String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Coupon {
  code          String     @id @db.VarChar(64)
  type          CouponType
  amount        Int
  minOrderCents Int?
  usageLimit    Int?
  usageCount    Int        @default(0)
  validFrom     DateTime?
  validTo       DateTime?
  active        Boolean    @default(true)
  createdAt     DateTime   @default(now())
}

model QuoteRequest {
  id                String      @id @default(cuid())
  productId         String?
  name              String
  email             String
  phone             String?
  message           String      @db.Text
  configurationJson Json?
  status            QuoteStatus @default(NEW)
  createdAt         DateTime    @default(now())

  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([productId])
}

// ─────────────────────────────────────────────────────────────
// Reviews
// ─────────────────────────────────────────────────────────────

model Review {
  id         String   @id @default(cuid())
  productId  String
  userId     String?
  authorName String?
  rating     Int
  title      String?
  body       String   @db.Text
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId, isApproved])
}

// ─────────────────────────────────────────────────────────────
// Content: Blog, Projects, Testimonials, FAQ, Menus
// ─────────────────────────────────────────────────────────────

model BlogPost {
  id           String        @id @default(cuid())
  slug         String        @unique @db.VarChar(200)
  status       ProductStatus @default(DRAFT)
  coverImage   String?       @db.Text
  categorySlug String?
  tags         String?       @db.Text
  authorId     String?
  publishedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  translations BlogPostTranslation[]

  @@index([status, publishedAt])
}

model BlogPostTranslation {
  id         String  @id @default(cuid())
  postId     String
  locale     String  @db.VarChar(8)
  title      String
  excerpt    String? @db.Text
  contentMdx String  @db.LongText

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, locale])
}

model Project {
  id          String      @id @default(cuid())
  slug        String      @unique @db.VarChar(200)
  projectType ProjectType
  location    String?
  year        Int?
  coverImage  String?     @db.Text
  isFeatured  Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  translations ProjectTranslation[]
  media        ProjectMedia[]

  @@index([projectType])
}

model ProjectTranslation {
  id          String  @id @default(cuid())
  projectId   String
  locale      String  @db.VarChar(8)
  title       String
  description String? @db.LongText

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, locale])
}

model ProjectMedia {
  id        String  @id @default(cuid())
  projectId String
  url       String  @db.Text
  altText   String?
  isBefore  Boolean @default(false)
  isAfter   Boolean @default(false)
  order     Int     @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Testimonial {
  id          String  @id @default(cuid())
  authorName  String
  role        String?
  location    String?
  avatarUrl   String? @db.Text
  rating      Int     @default(5)
  quote       String  @db.Text
  order       Int     @default(0)
  isPublished Boolean @default(true)
}

model FaqCategory {
  id    String @id @default(cuid())
  slug  String @unique @db.VarChar(64)
  name  String
  order Int    @default(0)
  faqs  Faq[]
}

model Faq {
  id         String  @id @default(cuid())
  categoryId String?
  locale     String  @db.VarChar(8)
  question   String
  answer     String  @db.LongText
  order      Int     @default(0)

  category FaqCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([categoryId, locale])
}

model Menu {
  id    String     @id @default(cuid())
  code  String     @unique @db.VarChar(32)
  label String
  items MenuItem[]
}

model MenuItem {
  id       String  @id @default(cuid())
  menuId   String
  parentId String?
  label    String
  url      String  @db.Text
  order    Int     @default(0)
  isMega   Boolean @default(false)
  meta     Json?

  menu     Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent   MenuItem?  @relation("MenuItemTree", fields: [parentId], references: [id], onDelete: SetNull)
  children MenuItem[] @relation("MenuItemTree")

  @@index([menuId])
  @@index([parentId])
}

// ─────────────────────────────────────────────────────────────
// SEO / Settings / Media
// ─────────────────────────────────────────────────────────────

model Seo {
  id          String  @id @default(cuid())
  target      String  @db.VarChar(160)
  locale      String  @db.VarChar(8)
  title       String?
  description String? @db.Text
  keywords    String? @db.Text
  canonical   String? @db.Text
  ogImage     String? @db.Text
  schemaJson  Json?

  @@unique([target, locale])
}

model Setting {
  key   String @id @db.VarChar(96)
  group String @default("general") @db.VarChar(64)
  value Json
}

model Media {
  id           String   @id @default(cuid())
  url          String   @db.Text
  publicId     String?  @db.VarChar(128)
  altText      String?
  mimeType     String?  @db.VarChar(64)
  width        Int?
  height       Int?
  sizeBytes    Int?
  folder       String?  @db.VarChar(128)
  uploadedById String?
  createdAt    DateTime @default(now())

  uploadedBy User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([folder])
  @@index([uploadedById])
}

model Newsletter {
  email          String    @id @db.VarChar(160)
  locale         String    @default("fr") @db.VarChar(8)
  subscribedAt   DateTime  @default(now())
  unsubscribedAt DateTime?
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String        @db.Text
  status    ContactStatus @default(NEW)
  createdAt DateTime      @default(now())

  @@index([status])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String   @db.VarChar(96)
  resource   String   @db.VarChar(96)
  resourceId String?  @db.VarChar(96)
  meta       Json?
  ip         String?  @db.VarChar(64)
  userAgent  String?  @db.Text
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([resource, resourceId])
  @@index([createdAt])
}
